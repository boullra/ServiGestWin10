# ---- Help
legend.title = ServiGestWin10 - Legend
legend.text = Rows in RED (with a red mark on the left):\nServices that must NEVER be stopped or disabled. The reason is shown in the "Critical / note" column. When you try to change them, the program asks for confirmation and offers to skip them.\n\nORANGE text in "Windows 10 default":\nThe current startup type differs from the Windows 10 default.\n\n"Windows 10 default":\nValue from a clean installation of Windows 10 Pro 22H2 (source: winhelponline.com). It may vary with the edition, version, hardware and installed software. "Unknown" = third-party service or not in the table.\n\nHeader check box: checks or unchecks all the services shown.
about.title = About ServiGestWin10
about.text = ServiGestWin10 {0}\nBulk Windows service manager\n\nC++17 / native Win32 API, no external dependencies.\n\nDefault startup table: {1} services (Windows 10 Pro 22H2).\nKnown critical services: {2}.\nInterface language: {3}.\n\nCommand line (administrator console):\n  ServiGestWin10.exe /export file.csv\n  ServiGestWin10.exe /import file.csv            (dry run)\n  ServiGestWin10.exe /import file.csv /apply\n  ... /apply /includecritical   (critical services too)\n  ... /lang:en|es|fr|zh-CN       (interface language)

# ---- Command line
cli.usage = ServiGestWin10 {0} - command-line usage:\n  /export file.csv                    saves the state of all services\n  /import file.csv                    shows what would change (dry run)\n  /import file.csv /apply             applies the state (requires administrator)\n  /import file.csv /apply /includecritical   also applies dangerous changes to critical services\n  /lang:en|es|fr|zh-CN                interface language
cli.exported.one = Exported {0} service to {1}
